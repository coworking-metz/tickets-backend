meta {
  name: addBooking
  type: http
  seq: 1
}

put {
  url: {{base}}/bliiida_bookings/{{userId}}/bookings/{{roomSlug}}
  body: json
  auth: none
}

headers {
  Authorization: Token {{token}}
}

body:json {
  {
    "date" : "2025-12-02",
    "start" : "12:30",
    "end" : "12:45"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
